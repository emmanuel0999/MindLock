/* PANTALLA 7: Acertijo diario */

.banner-diario {
    flex-direction: row;
    align-items: center;
    padding: 16px;
    border-radius: var(--radio);
    border-width: 2px;
    border-color: var(--color-acento);
    background-color: var(--color-acento-suave);
}

.banner-diario__icono {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background-color: var(--color-acento);
    align-items: center;
    justify-content: center;
}

.boton-diario {
    align-self: stretch;
}

.diario-check {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    background-color: var(--color-exito-suave);
    border-width: 3px;
    border-color: var(--color-exito);
    align-items: center;
    justify-content: center;
}

.llama-racha {
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.llama-racha--grande { scale: 1.5 1.5; }

.cuenta-regresiva {
    font-size: var(--fuente-xxl);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

/* Calendario semanal */
.fila-semana {
    flex-direction: row;
    justify-content: space-between;
}

.dia {
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.dia__letra {
    font-size: var(--fuente-xs);
    color: var(--color-texto-sec);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dia__circulo {
    width: 38px;
    height: 38px;
    margin-top: 6px;
    border-radius: 19px;
    border-width: 2px;
    border-color: var(--color-borde);
    background-color: var(--color-fondo);
    align-items: center;
    justify-content: center;
}

.dia__circulo--hecho {
    background-color: var(--color-acento-suave);
    border-color: var(--color-acento);
}

.dia__circulo--hoy {
    border-color: var(--color-accion);
    border-width: 3px;
}
